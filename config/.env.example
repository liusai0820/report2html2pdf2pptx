# OpenRouter API
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Adobe PDF Services
ADOBE_CLIENT_ID=your_adobe_client_id_here
ADOBE_CLIENT_SECRET=your_adobe_client_secret_here

# PPTX 转换控制 (设为 true 可禁用 Adobe PPTX 转换)
DISABLE_PPTX=false

# Browserless (可选，用于云端 Puppeteer)
BROWSERLESS_URL=wss://chrome.browserless.io?token=your_token_here

# API 服务器配置
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# 文件存储路径
INPUT_DIR=./input
OUTPUT_DIR=./output

# 任务配置
MAX_CONCURRENT_TASKS=3
TASK_TIMEOUT=600

# Unsplash API
UNSPLASH_API_KEY=your_unsplash_access_key_here
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
UNSPLASH_SECRET_KEY=your_unsplash_secret_key_here

# Supabase (Frontend Auth & History)
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_API_URL=http://localhost:8005/api

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# SMTP Email (用于自动补发文件)
SMTP_HOST=smtp.126.com
SMTP_PORT=465
SMTP_USER=your_email@126.com
SMTP_PASSWORD=your_email_auth_code
SMTP_SSL=true

# ComfyUI Configuration
COMFYUI_ENABLED=false
COMFYUI_HOST=127.0.0.1:8188
