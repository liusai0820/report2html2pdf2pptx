# ============================================
# Render 环境变量配置示例
# 复制这些值到 Render Dashboard > Environment
# ============================================

# ===== 必需配置 =====

# OpenRouter API (AI 模型调用)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=google/gemini-3-flash-preview

# Supabase (用户认证和数据库)
VITE_SUPABASE_URL=https://xxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ===== 可选配置 =====

# Adobe PDF Services (PPTX 转换)
PDF_SERVICES_CLIENT_ID=xxxxxxxxxxxxxxxx
PDF_SERVICES_CLIENT_SECRET=xxxx-xxxxx

# Unsplash (图片搜索)
UNSPLASH_API_KEY=xxxxxxxxxxxxxxxxxxx

# Telegram 通知
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFGH
TELEGRAM_CHAT_ID=1234567890

# SMTP 邮件
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_SSL=true

# ===== Cloudflare R2 存储 (推荐) =====
# 在 Cloudflare Dashboard > R2 > Overview > Manage R2 API Tokens 创建
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=slidecraft
# 可选：自定义域名 (需要在 R2 bucket 配置 Custom Domain)
R2_PUBLIC_URL=https://cdn.yourdomain.com

# ===== 禁用配置（Render 限制）=====

# 禁用 ComfyUI (Render 无 GPU)
COMFYUI_ENABLED=false

# 禁用 PPTX 转换（可选，减少资源消耗）
DISABLE_PPTX=true

# ===== 资源限制配置（适配 Starter Plan）=====

# 并发限制
MAX_CONCURRENT_REQUESTS=2
MAX_CONCURRENT_PDF_TASKS=1
TIMEOUT_SECONDS=120
UVICORN_WORKERS=1

# ===== Python/Node 优化 =====
PYTHONUNBUFFERED=1
PYTHONPATH=/app/src
API_HOST=0.0.0.0
API_PORT=8005
